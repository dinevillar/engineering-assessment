{
  "name": "stonecutter-engineering-assessment",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "app": "next build && next start -p 3000",
    "demo": "node --import tsx main.ts report --brand cedar-coast",
    "report": "node --import tsx main.ts report",
    "query": "node --import tsx main.ts query",
    "reset": "node --import tsx main.ts reset",
    "test": "npm run test:ts && npm run test:python",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test:ts": "node --import tsx --test tests/*.test.ts",
    "test:python": "node --import tsx scripts/python.ts test",
    "setup": "node --import tsx scripts/python.ts setup"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
